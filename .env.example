# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # public "anon" key (safe in the browser; RLS protects data)
SUPABASE_SERVICE_ROLE_KEY=               # SECRET. Server only. Saves contact-form enquiries.

# --- Public site address (used for canonical links, sitemap, email links) ---
NEXT_PUBLIC_SITE_URL=https://www.hospofresh.com.au

# --- Enquiry notification email (Resend) ---
RESEND_API_KEY=                          # SECRET
RESEND_FROM="Hospo Fresh Website <website@hospofresh.com.au>"   # must be on a domain verified in Resend
INQUIRY_NOTIFY_TO=info@hospofresh.com.au # comma-separate for multiple recipients

# --- Bot protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=                    # SECRET

# --- Vercel Cron (keeps Supabase from pausing). Any long random string. ---
CRON_SECRET=                             # SECRET

# --- Optional: shared rate limiting (Upstash Redis). Without it a per-instance
#     in-memory limiter is used; Turnstile is the main spam defence. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
